{
  "name": "@tsfullstack/module-loader",
  "version": "1.0.0",
  "description": "Automatic module discovery and aggregation for TsFullStack",
  "keywords": [
    "auto-discovery",
    "module-loader",
    "tsfullstack"
  ],
  "license": "ISC",
  "author": "",
  "bin": {
    "tsfullstack-modules": "./dist/cli.js"
  },
  "type": "module",
  "exports": {
    "./generated/backend.ts": "./generated/backend.ts",
    "./generated/frontend.ts": "./generated/frontend.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "tsc": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
