{
  "name": "info-flow",
  "version": "0.0.4",
  "private": true,
  "description": "manifest.json description",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "tsc": "vue-tsc",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "release": "pnpm build && pnpm build:firefox && pnpm zip && pnpm zip:firefox",
    "release:version": "npm version patch",
    "release:prepare": "pnpm install && pnpm tsc && pnpm release"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tsfullstack/backend": "workspace:*",
    "@tsfullstack/shared-frontend": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/proxy-service": "^3.0.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "html-to-text": "^10.0.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "reka-ui": "catalog:",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "5.9.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
