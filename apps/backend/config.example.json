{
  "$schema": "./config.schema.json",
  "systemAdminUser": {
    "email": "admin@example.com",
    "password": "your-secure-password-here"
  },
  "uploadDir": "./uploads",
  "databasePath": "./database/dev.db",
  "ApiProxy": {
    "github": "https://api-proxy.example.com"
  },
  "groupEntry": {
    "adminToken": "your-group-entry-admin-token-at-least-16-chars",
    "officialAccountQrUrl": "https://your-cdn.example.com/official-account-qr.png",
    "officialAccountName": "你的公众号名称",
    "replyKeyword": "加群",
    "notifyUrl": "https://sctapi.ftqq.com/your-sendkey.send"
  },
  "OAuth_github": {
    "clientId": "your-github-client-id",
    "clientSecret": "your-github-client-secret",
    "redirectUri": "https://yourdomain.com/oauth/github",
    "scope": ["read:user", "user:email"]
  }
}
