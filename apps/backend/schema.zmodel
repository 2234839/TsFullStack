// This is a sample model to get you started.

/// Policy plugin for access control
plugin policy {
    provider = '@zenstackhq/plugin-policy'
}

/// Soft-delete plugin - 删除改写为打时间戳墓碑，读取自动过滤（v3.8.0+，仅对标记 @deletedAt 的模型生效）
plugin softDelete {
    provider = '@zenstackhq/plugin-soft-delete'
}

/// TypeScript plugin for code generation
plugin typescript {
    provider = '@core/typescript'
    output = './.zenstack'
}

/// A sample data source using local sqlite db.
datasource db {
    provider = 'sqlite'
    url = env('DATABASE_URL')
}

/// Base types for mixin - 通用字段类型定义
type BaseTime {
    created DateTime @default(now())
    updated DateTime @updatedAt
}

type BaseId {
    id Int @id @default(autoincrement())
}

/// 全局权限控制 - 纯抽象层，仅包含权限策略
/// 继承此类型会自动获得：管理员拥有完全访问权限
type BaseGlobalAuth {
    @@allow('all', auth().role?[name == 'admin'])
}

/// 通用基础类型，包含时间和ID，继承全局权限
type Base with BaseTime, BaseId, BaseGlobalAuth {
}

/// 纯抽象层，包含全局权限，但没有ID字段，适合需要自定义id主键的模型
type NotIdBase with BaseTime, BaseGlobalAuth {
}

/// 角色
model Role with Base {
    name  String @unique
    users User[]

    @@allow("read",auth() != null)

    /** 索引优化 - 优化按名称查询角色 */
    @@index([name])
}

/// User model
model User with NotIdBase {
    id           String         @id @default(cuid())
    // 注意：v3 中移除了 future()，id 是主键数据库层已禁止修改
    email        String         @unique @length(6, 32)
    // password 字段 - 在应用层处理哈希，不再使用 @password 属性（v3 已移除）
    password     String
    contents     Content[]
    role         Role[]
    file         File[]
    userSession  UserSession[]

    avatar       String?      
    nickname     String?
    /** 禁用账号密码登录（只允许第三方渠道登录，类似可信设备授权；需至少绑定一个渠道才可开启） */
    passwordLoginDisabled Boolean @default(false)

    /** 允许用户读取自己的完整信息 */
    @@allow('read', auth() == this)
    /** 允许用户更新自己的信息（avatar, nickname 等），但管理员权限由全局策略覆盖 */
    @@allow('update', auth() == this)
    /**
     * 禁止非管理员通过修改 role 关系提权
     * post-update 检查：如果更新后用户拥有了之前没有的 admin 角色，则拒绝
     * 管理员（由 BaseGlobalAuth @@allow('all') 授权）不受此限制
     */
    @@deny('post-update', auth().role?[name != 'admin'] && role?[name == 'admin'])
    userData     UserData[]
    oAuthAccount OAuthAccount[]
    /** 被授权管理的引流空间（多对多） */
    spaceOperators GroupSpaceOperator[]
    channelMessages ChannelMessage[]
    word         Word[]
    /** 代币记录 */
    tokens Token[]
    /** 任务记录 */
    tasks Task[]
    /** 代币消耗记录 */
    tokenTransactions TokenTransaction[]
    /** 资源记录 */
    resources Resource[]
    /** 套餐订阅记录 */
    tokenSubscriptions UserTokenSubscription[]
    /** 支付订单记录 */
    orders Order[]
    /** 索引优化 */
    @@index([created])
}

/// 资源类型枚举
enum ResourceType {
    IMAGE    // 图片
    TEXT     // 文本
    VIDEO    // 视频
    AUDIO    // 音频
    FILE     // 文件
}

/// 通用资源模型
model Resource with Base {
    /** 资源类型 */
    type ResourceType

    /** 资源标题 */
    title String

    /** 资源描述 */
    description String?

    /** 资源元数据（JSON存储，根据类型不同存储不同信息） */
    metadata Json

    /** 资源状态 */
    status String @default("pending")

    /** 关联的文件（如果有物理文件） */
    fileId Int?
    file File? @relation(fields: [fileId], references: [id])

    /** 关联任务 */
    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    taskId Int

    /** 关联用户 */
    user User @relation(fields: [userId], references: [id])
    userId String

    /** 标签 */
    tags String?

    /** 索引优化 */
    @@index([userId, type])
    @@index([taskId])
    @@index([status, created])

    /** 权限控制 */
    @@allow('read,create,update,delete', auth() == user)
    @@allow('read', auth() != null && status == "public")
}

/// UserSession 用于存储用户的登录会话信息。每个会话都有一个唯一的 token 和过期时间。
model UserSession with Base {
    /** 会话令牌（CSPRNG 生成，代码层填充，见 _genUserSession.ts） */
    token     String
    expiresAt DateTime
    userId    String
    user      User     @relation(fields: [userId], references: [id])

    /// 只允许用户读取和创建
    @@allow('read,create', auth() == user)
    // 禁止过期session 被用户读取，但管理员除外
    @@deny('all',(expiresAt < now()) &&  (auth().role?[name == 'admin']==false))

    /** 索引优化 - 优化会话查询和过期清理 */
    @@index([userId, expiresAt])
    @@index([token])
}

enum OauthProvider {
    GITHUB
    LINUXDO
    WECHAT
}

/// 口令验证通道：口令通过哪个渠道回传（微信只是第一个通道，将来可扩展邮箱/短信）
enum PasscodeChannel {
    WECHAT_OFFICIAL // 微信公众号回复口令
}

/// 口令用途：登录只是第一种，将来可扩展资源访问/激活码等
enum PasscodePurpose {
    LOGIN // 登录：验证通过后自动登录/建号
    BIND // 绑定：把通道身份（如微信 openid）挂到已登录账号上
    MERGE_VERIFY // 合并验证：验证通道身份归属的账号，作为被合并账号身份确认
}

/// 口令状态机：PENDING 待验证 → VERIFIED 已验证（待消费）→ CONSUMED 已消费
enum PasscodeStatus {
    PENDING
    VERIFIED
    CONSUMED
}

/// 通用验证口令：发起方生成 code + ticket 并轮询；用户经通道（如公众号回复）回传 code；
/// 通道处理器回填 channelIdentity；发起方消费后按 purpose 执行业务（登录/授权等）
model VerificationPasscode with Base {
    /** 一次性数字口令（6 位，用户在通道侧回传） */
    code String

    /** 发起方轮询票据（secret，仅发起方持有；CSPRNG 生成，代码层填充，见 PasscodeService.ts） */
    ticket String @unique

    /** 回传通道 */
    channel PasscodeChannel

    /** 业务用途 */
    purpose PasscodePurpose

    /** 状态机 */
    status PasscodeStatus @default(PENDING)

    /** 通道侧身份标识（微信=openid，邮箱=邮箱地址），验证通过时回填 */
    channelIdentity String?

    /** 发起方上下文（其他用途时存放业务数据） */
    payload Json?

    /** 过期时间（创建后 5 分钟） */
    expiresAt DateTime

    /** 验证通过时间 */
    verifiedAt DateTime?

    /** 消费时间 */
    consumedAt DateTime?

    /** 同通道内口令唯一（创建时惰性清理过期记录避免冲突） */
    @@unique([channel, code])
    @@index([status, expiresAt])
}

/// 第三方账号关联
model OAuthAccount with Base {
    userId     String        // 关联的用户ID
    user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

    provider   OauthProvider // 第三方提供商名称，
    providerId String        // 第三方提供商的唯一标识符
    // 用户资料数据
    profile    Json?         // 存储原始的用户资料数据

    // 权限控制，绝对不应该让用户可以直接修改这里的数据，否则就能顶替别人的账号了
    @@allow('read', auth() == user)
}

// 存储策略枚举
enum StorageType {
    LOCAL
    S3
}

enum FileStatusEnum {
    public
    private
    protected
    deleted
}
model File with Base {
    filename    String      // 原始文件名
    mimetype    String      // 文件类型
    size        Int         // 文件大小（字节）
    path        String      // 存储路径或URL
    storageType StorageType // 存储类型
    metadata    Json?       // 额外的元数据
    status      FileStatusEnum @default(private)// 文件状态
    author      User           @relation(fields: [authorId], references: [id])
    authorId    String

    /** 资源记录 */
    resources Resource[]

    @@allow('read,create,delete', auth() == author)
    /** 公开文件（头像/树洞配图等公开场景）任何登录用户可读 */
    @@allow('read', auth() != null && status == 'public')
}


enum LogLevel {
    DEBUG
    INFO
    WARN
    ERROR
}
model SystemLog with BaseId,BaseGlobalAuth {
    level LogLevel

    /// 摘要消息（如 "35ms db.user.findMany"）
    message String?

    /// 请求内全部日志行（reqCtx.logs 数组）
    logs Json?

    /// 触发请求的用户 ID（未认证请求为 null）
    authUserId String?

    /// 进程内请求序号（与 console 日志 #N 前缀一致，可反查 DiagTrace 时间线）
    reqId Int?

    /// RPC 方法名（如 db.user.findMany，非 RPC 请求为路径）
    method String?

    /// 请求总耗时 ms
    totalMs Int?

    /// 是否以错误结束
    error Boolean @default(false)

    created DateTime @default(now())

    /// 行为记录保留 183 天（网安法第 21 条：网络日志留存不少于六个月；清理任务见 index.ts behaviorLogCleanupLoop）
    @@index([created])
    @@index([authUserId, created])
}
/// 用户数据存储模型 - 用于存储用户的应用JSON数据
model UserData with Base {
    // 数据标识符，可用于区分不同类型或用途的数据
    key         String
    // 实际存储的JSON数据
    data        Json
    // 数据描述（可选）
    description String?
    // 版本号，用于处理数据更新冲突
    version     Int     @default(1)
    // 关联的用户
    user        User    @relation(fields: [userId], references: [id])
    userId      String
    // 标签，用于分类和搜索
    tags        String?
    // 应用标识符，用于区分不同应用的数据
    appId       String?

    // 用户和key的组合唯一索引，确保每个用户的每个key只有一条记录
    @@unique([userId, key, appId])

    // 权限控制：用户只能读取和操作自己的数据
    @@allow('read,create,update,delete', auth() == user)
}

/// 任务队列处理
model Queue with Base {
    name        String    // 队列名称，可用于区分不同类型的任务
    payload     Json    // 任务数据，JSON 格式
    status      String    // PENDING, PROCESSING, COMPLETED, FAILED
    priority    Int       @default(0) // 优先级，数字越大优先级越高
    attempts    Int       @default(0) // 尝试次数
    maxAttempts Int       @default(3) // 最大尝试次数
    workerId    String?   // 处理该任务的消费者ID
    result      Json?   // 处理结果，JSON 格式
    error       String?   // 错误信息
    startedAt   DateTime? // 开始处理时间
    completedAt DateTime? // 完成时间
    runAt       DateTime  @default(now()) // 计划执行时间，支持延迟任务

    @@index([status, runAt, priority]) // 索引优化查询性能
    @@index([name, status]) // 按队列名称和状态查询
    @@index([workerId, status]) // 按工作者和状态查询
}


// ===== 下面是业务模型，与系统基础无关，可自行选择需要的模块删改 =====

/// 内容类型枚举
enum ContentType {
    POST         /** 树洞帖子 */
    ARTICLE      /** 文章（未来扩展） */
    QUESTION     /** 问答（未来扩展） */
}

/// 内容可见性枚举
enum ContentVisibility {
    DRAFT       /** 草稿 - 仅作者可见 */
    PRIVATE     /** 私密 - 仅作者可见 */
    MEMBERS     /** 登录用户可见 */
    PUBLIC      /** 公开 - 游客也可见 */
}

/// 通用内容基类 - 使用多态性支持多种内容类型
model Content with Base {
    /** 内容类型（discriminator 字段） */
    type ContentType

    /** 标题 */
    title String? @length(0, 256)

    /** 内容正文 */
    content String

    /** 可见性 */
    visibility ContentVisibility @default(DRAFT)

    /** 作者 */
    author User @relation(fields: [authorId], references: [id])
    authorId String

    /** 多态委托 - 关键配置 */
    @@delegate(type)

    /** 索引优化：按作者和类型查询 */
    @@index([authorId, type, created])
    /** 索引优化：查询公开的内容 */
    @@index([visibility, created])

    /** 草稿和私密 - 仅作者可读写 */
    @@allow('read', auth() != null && author == auth() && visibility in [DRAFT, PRIVATE])
    @@allow('create,update,delete', auth() != null && author == auth() && visibility in [DRAFT, PRIVATE])

    /** 登录用户可见 - 所有登录用户可读，作者可写 */
    @@allow('read', auth() != null && visibility == MEMBERS)
    @@allow('create,update,delete', auth() != null && author == auth() && visibility == MEMBERS)

    /** 公开 - 所有人可读，作者可写 */
    @@allow('read', visibility == PUBLIC)
    @@allow('create,update,delete', auth() != null && author == auth() && visibility == PUBLIC)
}

/// 树洞帖子 - 继承 Content
model Post extends Content {
    /** 父帖子ID（null=主题帖，非null=回复帖） */
    parentId Int?

    /** 父帖子关系（多对一） */
    parentPost Post? @relation("PostReplies", fields: [parentId], references: [id])

    /** 回复列表（一对多） */
    replies Post[] @relation("PostReplies")
}

/// AI 英语学习数据模型
model Word with Base {
    /// word 的小写形式，作为唯一标识符
    key           String
    /// 单词原文
    word          String
    /// 记忆等级 (掌握度 0-10)
    memoryLevel   Int      @default(0)
    /// 点击次数
    clickCount    Int      @default(0)
    /// 最后点击时间戳
    lastClickTime DateTime @default(now())
    /// 眼熟度 (0-100, 基于见面次数和时间衰减)
    familiarity   Int      @default(0)
    /// 翻译列表（存储为JSON数组）
    translations  Json
    /// AI翻译（可选）
    aiTranslation String?
    /// 难度系数（可选）
    difficulty    Float?
    /// 例句列表（存储为JSON数组，可选）
    examples      Json?
    /// 语法信息（可选）
    grammar       String?
    /// 发音信息（可选）
    pronunciation String?

    /// 关联的用户
    author        User     @relation(fields: [authorId], references: [id])
    authorId      String
    /// 确保每个用户的单词key唯一
    @@unique([key, authorId])
    /// 权限控制：用户只能读取和操作自己的单词数据
    @@allow('read,create,update,delete', auth() == author)
}

/// AI 模型配置
model AiModel with Base {
    /// 模型名称
    name        String
    /// 模型标识符
    model       String
    /// 模型类型
    modelType   AiModelType @default(TEXT)
    /// API基础URL
    baseUrl     String
    /// API密钥
    apiKey      String
    // 注意：不再使用 @omit 属性（v3 已移除），需要在查询时手动排除
    /// 最大Token数
    maxTokens   Int     @default(2000)
    /// 温度参数
    temperature Float   @default(0.7)
    /// 是否启用
    enabled     Boolean @default(true)
    /// 权重（用于负载均衡）
    weight      Int     @default(100)
    /// 每分钟请求限制
    rpmLimit    Int     @default(60)
    /// 每小时请求限制
    rphLimit    Int     @default(1000)
    /// 每日请求限制
    rpdLimit    Int     @default(10000)
    /// 描述信息
    description String?
    /// 登录用户免费可用：为 true 时才允许通过 AI 代理接口（proxyOpenAI）调用；未标注的模型不对免费代理开放
    freeForLoginUser Boolean @default(false)
    /// 模型配置（JSON存储，用于存储不同类型模型的特定配置）
    config      Json?
    /// 软删除墓碑时间（null=未删除）；delete 被改写为设置此字段，读取自动过滤
    deletedAt   DateTime? @deletedAt
}

/// AI 模型类型枚举
enum AiModelType {
    TEXT       // 文本生成模型（GPT、Claude等）
    IMAGE      // 图片生成模型（DALL-E、Stability、通义千问等）
    VIDEO      // 视频生成模型（未来）
    AUDIO      // 音频生成模型（未来）
    TRANSLATION // 翻译模型（未来）
}

/// ai API调用日志记录
model AiCallLog with Base {
    /// 客户端IP地址
    clientIp     String
    /// 用户ID（可选，未登录用户为null）
    userId       String?
    /// AI模型ID
    aiModelId    Int
    /// 模型标识符（如 gpt-3.5-turbo, claude-3-sonnet 等）
    modelName    String
    /// 输入的token数量
    inputTokens  Int?
    /// 输出的token数量
    outputTokens Int?
    /// 调用是否成功
    success      Boolean  @default(true)
    /// 调用时间戳
    timestamp    DateTime @default(now())

    @@index([clientIp, timestamp])
    @@index([userId, timestamp])
    @@index([aiModelId, timestamp])
    @@index([modelName, timestamp])
    @@index([userId, modelName])

    /// 权限控制：
    /// - 管理员可以完全访问（所有权限）
    /// - 普通用户可以查看自己的数据（只读）
    /// - 未登录用户不能访问
    @@allow('read',auth() != null && userId == auth().id)
}

/// ==================== 支付系统 ====================

/// 支付渠道枚举
enum PaymentProvider {
  MBD       // 面包多
  AFDIAN    // 爱发电
  WECHAT    // 微信好友支付（站长人工确认）
}

/// 订单状态枚举
enum OrderStatus {
  PENDING    // 待支付
  PAID       // 已支付
  FAILED     // 支付失败
  CANCELLED  // 已取消
  REFUNDED   // 已退款
}

/// 支付订单
model Order with Base {
  /** 订单号（对外展示的唯一标识） */
  orderNo String @unique

  /** 关联用户 */
  user User @relation(fields: [userId], references: [id])
  userId String

  /** 关联套餐 */
  package TokenPackage @relation(fields: [packageId], references: [id])
  packageId Int

  /** 支付渠道 */
  provider PaymentProvider

  /** 订单金额（分） */
  amount Int

  /** 实际支付金额（分，可能因优惠不同） */
  paidAmount Int?

  /** 订单状态 */
  status OrderStatus @default(PENDING)

  /** 第三方交易号 */
  tradeNo String?

  /** 支付渠道返回的原始数据（JSON） */
  providerData Json?

  /** 支付完成时间 */
  paidAt DateTime?

  /** 过期时间 */
  expireAt DateTime

  /** 索引优化 */
  @@index([userId, status])
  @@index([orderNo])
  @@index([status, created])

  /** 权限控制：用户可读自己的订单；创建/更新全走服务端 PaymentService，RPC 不开放 */
  @@allow('read', auth() == user)
}

/// ==================== 代币系统 ====================

/// 代币类型枚举
enum TokenType {
    MONTHLY    // 月度代币（每月重置）
    YEARLY     // 年度代币（每年重置）
    PERMANENT  // 永久代币（永不过期）
}

/// 代币套餐
model TokenPackage with Base {
    /** 套餐名称 */
    name String

    /** 套餐描述 */
    description String?

    /** 代币类型 */
    type TokenType

    /** 代币数量 */
    amount Int

    /** 价格（分） */
    price Int?

    /** 套餐时长（月数，0表示永久） */
    durationMonths Int @default(0)

    /** 是否启用 */
    active Boolean @default(true)

    /** 排序顺序 */
    sortOrder Int @default(0)

    /** 专用类型（JSON数组，空数组或null表示通用代币；非空数组表示只能用于指定类型的任务，例如：["AI_IMAGE_GENERATION", "AI_TEXT_GENERATION"]） */
    restrictedType Json @default('[]')

    /** 用户订阅记录 */
    userSubscriptions UserTokenSubscription[]
    /** 支付订单记录 */
    orders Order[]

    /** 索引 */
    @@index([active, sortOrder])

    /** 权限控制 */
    @@allow('read', auth() != null)
}

/// 用户代币套餐订阅
model UserTokenSubscription with Base {
    /** 关联用户 */
    user User @relation(fields: [userId], references: [id])
    userId String

    /** 关联套餐 */
    package TokenPackage @relation(fields: [packageId], references: [id])
    packageId Int

    /** 订阅开始时间 */
    startDate DateTime @default(now())

    /** 订阅结束时间（null表示永久） */
    endDate DateTime?

    /** 下次发放时间（月度套餐每月月初发放） */
    nextGrantDate DateTime

    /** 是否激活 */
    active Boolean @default(true)

    /** 发放次数（用于记录已发放了几个月） */
    grantsCount Int @default(0)

    /** 索引 */
    @@index([userId, active])
    @@index([nextGrantDate])

    /** 权限控制 */
    @@allow('read', auth() == user)
}

/// 代币记录
model Token with Base {
    /** 代币类型 */
    type TokenType

    /** 代币数量 */
    amount Int

    /** 已使用数量 */
    used Int @default(0)

    /** 过期时间 */
    expiresAt DateTime?

    /** 专用类型（JSON数组，空数组或null表示通用代币；非空数组表示只能用于指定类型的任务） */
    restrictedType Json @default('[]')

    /** 关联用户 */
    user User @relation(fields: [userId], references: [id])
    userId String

    /** 代币来源（系统赠送、购买、活动奖励等） */
    source String @default("system")

    /** 来源ID（如订单ID、活动ID等） */
    sourceId String?

    /** 描述信息 */
    description String?

    /** 是否已激活（延迟发放的代币） */
    active Boolean @default(true)

    /** 索引优化 */
    @@index([userId, type, expiresAt])
    @@index([userId, active])
    @@index([expiresAt])

    /** 权限控制 */
    @@allow('read', auth() == user)
}

/// 代币消耗记录
model TokenTransaction with Base {
    /** 消耗的代币数量 */
    amount Int

    /** 消耗时的代币类型 */
    tokenType TokenType

    /** 关联用户 */
    user User @relation(fields: [userId], references: [id])
    userId String

    /** 关联任务 */
    task Task @relation(fields: [taskId], references: [id])
    taskId Int

    /** 余额快照（消耗后的剩余代币） */
    balanceSnapshot Json

    /** 备注 */
    note String?

    /** 索引优化 */
    @@index([userId, taskId])
    @@index([userId, created])
    @@index([taskId])

    /** 权限控制 */
    @@allow('read', auth() == user)
}

/// ==================== 任务系统 ====================

/// 任务类型枚举
enum TaskType {
    AI_IMAGE_GENERATION    // AI 图片生成
    AI_TEXT_GENERATION     // AI 文本生成
    AI_TRANSLATION         // AI 翻译
    AI_VIDEO_GENERATION    // AI 视频生成（未来）
    CUSTOM                 // 自定义任务
}

/// 任务状态枚举
enum TaskStatus {
    PENDING       // 等待处理
    PROCESSING    // 处理中
    COMPLETED     // 已完成
    FAILED        // 失败
    CANCELLED     // 已取消
}

/// 通用任务模型
model Task with Base {
    /** 任务类型 */
    type TaskType

    /** 任务状态 */
    status TaskStatus @default(PENDING)

    /** 任务标题 */
    title String

    /** 任务描述 */
    description String?

    /** 任务参数（JSON 存储，如提示词、尺寸等） */
    inputParams Json

    /** 任务结果（JSON 存储，如生成的图片URL、文本等） */
    outputResult Json?

    /** 消耗的代币数量 */
    tokenCost Int

    /** 错误信息 */
    error String?

    /** 开始时间 */
    startedAt DateTime?

    /** 完成时间 */
    completedAt DateTime?

    /** 关联用户 */
    user User @relation(fields: [userId], references: [id])
    userId String

    /** 代币消耗记录 */
    transactions TokenTransaction[]

    /** 外部任务ID（用于查询第三方服务进度） */
    externalTaskId String?

    /** 标签（用于分类和搜索） */
    tags String?

    /** 资源记录 */
    resources Resource[]

    /** 索引优化 */
    @@index([userId, status])
    @@index([userId, type])
    @@index([status, created])
    @@index([type, created])

    /** 权限控制：RPC 只开放读；写操作全部走服务端代码路径（TaskService / TokenService 等），防客户端伪造任务/代币记录 */
    @@allow('read', auth() == user)
}

/// 群二维码状态枚举
enum GroupQRCodeStatus {
    ACTIVE      // 排队出码中（多码轮换）
    FULL        // 群已满，不再出码
    ARCHIVED    // 已下线（手动停用）
}

/// 私域空间（核心维度）：一个空间持有公众号引导 + 轮换的微信群码池。
/// 公开链接就是 /group/<空间名>，永久不变；「用户从哪个项目/渠道来」用 ?from= 参数记录，不建项目实体
model GroupSpace with Base {
    /** 空间标识（URL 中的永久锚点，/group/<name>，如 tsfullstack / silkpulse），创建后不可修改 */
    name String @unique

    /** 空间显示名 */
    displayName String?

    /** 排序权重（小的在前） */
    sortOrder Int @default(0)

    /** 公众号名称（该空间的长期引导，随群码失效成为主引导） */
    officialName String?

    /** 公众号回复关键词 */
    officialReplyKeyword String @default('加群')

    /** 公众号关注引导语 */
    officialGuideText String?

    /** 公众号二维码图片相对路径（相对 uploadDir；空 = 未上传，回退 config.json 的 URL） */
    officialQrImagePath String?

    /** 被授权管理该空间的操作员 */
    operators GroupSpaceOperator[]

    qrcodes GroupQRCode[]

    @@index([sortOrder])
}

/// 消息渠道枚举（存档用，与口令通道独立；目前只有微信公众号）
enum MessageChannel {
    WECHAT_OFFICIAL
}

/// 消息方向：IN 用户发来 / OUT 系统回复
enum MessageDirection {
    IN
    OUT
}

/// 渠道消息存档：公众号等消息渠道的收发全量留痕（管理页可查，指令操作审计的依据）
model ChannelMessage with Base {
    /** 渠道 */
    channel MessageChannel

    /** 方向 */
    direction MessageDirection

    /** 消息类型（text/image/event…） */
    msgType String

    /** 对端渠道身份（公众号=用户 openid） */
    peerId String

    /** 文本内容（指令原文也在这里；图片消息为空） */
    content String?

    /** 图片素材 ID（图片消息用） */
    mediaId String?

    /** 关联账号（openid 已绑定时回填，方便直接看是谁） */
    userId String?
    user User? @relation(fields: [userId], references: [id])

    /** 权限：管理员看全部；登录用户只能看自己（openid 已绑定到自己账号）的消息 */
    @@allow('read', auth() != null && userId == auth().id)

    @@index([channel, peerId, created])
    @@index([channel, created])
}

/// 空间操作员：授权某账号管理某引流空间（群码/公众号码上传与轮换）。
/// 权限粒度是「账号×空间」，与消息渠道无关；公众号指令只是目前唯一的消息渠道，
/// 鉴权链：渠道身份（openid）→ OAuthAccount → userId → 本表校验其对该空间的操作权
model GroupSpaceOperator with Base {
    /** 被授权的账号 */
    userId String
    user User @relation(fields: [userId], references: [id])

    /** 可管理的空间 */
    spaceId Int
    space GroupSpace @relation(fields: [spaceId], references: [id])

    /** 同一账号对同一空间只授权一次 */
    @@unique([userId, spaceId])

    /** 权限：管理员可增删查；用户只能看自己的授权（写入/撤销只能管理员） */
    @@allow('read', auth() != null && userId == auth().id)
}

/// 微信群二维码（私域引流）
/// 维护模型：一个空间维护一个群码池，可同时存在多个 ACTIVE 码排队轮换——
/// 出码按上传时间先进先出，当前码扫满（手动标 FULL）或过期后自动切到下一个，公开链接不变
model GroupQRCode with Base {
    /** 所属私域空间（群码池按空间维度共享） */
    spaceId Int
    space GroupSpace @relation(fields: [spaceId], references: [id])

    /** 群名称（如「TsFullStack 交流群 2 号」） */
    groupName String?

    /** 图片存储相对路径（相对 uploadDir，不含原图文件名，防路径猜测） */
    imagePath String

    /** 图片字节数（响应 Content-Length 用） */
    imageSize Int

    /** 图片 MIME 类型 */
    imageMime String

    /** 上传时刻即生效时刻 */
    uploadedAt DateTime @default(now())

    /** 过期时刻 = uploadedAt + 7 天（含 5 分钟提前量，宁早勿晚） */
    expiresAt DateTime

    /** 状态：ACTIVE 排队出码 / FULL 已扫满 / ARCHIVED 已下线（同空间可多个 ACTIVE 排队） */
    status GroupQRCodeStatus @default(ACTIVE)

    /** 博主备注 */
    note String?

    /** 索引优化：按空间取出码队列 / 按上传时间列池 */
    @@index([spaceId, status])
    @@index([spaceId, uploadedAt])
}

/// 引流统计（按日聚合，date+space+from 联合主键）
/// from 是链接上的来源参数（?from=ccdd），自由文本，回答「哪个项目/repo 真的在带人进群」
model GroupStatDaily {
    /** 日期（本地时区 YYYY-MM-DD） */
    date String

    /** 私域空间标识（/group/<space>） */
    space String

    /** 来源参数（链接 ?from= 的值，空字符串 = 未携带来源） */
    from String @default("")

    /** 动态图 PV（README 内嵌图展示次数） */
    imgPv Int @default(0)

    /** 落地页 PV */
    pagePv Int @default(0)

    /** 落地页 UV（当日 cookie 去重） */
    pageUv Int @default(0)

    created DateTime @default(now())
    updated DateTime @updatedAt

    @@id([date, space, from])
    @@index([date])
    @@index([space])
}

/// API 慢请求诊断追踪：仅落盘超过阈值的请求（正常请求零写入开销）
/// timeline 记录各阶段耗时切分，loopLagMaxMs 用于区分硬阻塞（同步冻结事件循环）与事件等待
model DiagTrace with BaseId,BaseGlobalAuth {
    /// RPC 方法名（如 groupEntryApi.listSpaces，非 RPC 路由填路径）
    method String

    /// 请求总耗时 ms
    totalMs Int

    /// 请求在处理队列中的排队等待 ms（进程繁忙程度指标）
    queueWaitMs Int

    /// 鉴权（getDbAuth 含用户查询）耗时 ms
    authMs Int?

    /// SQL 执行次数
    sqlCount Int @default(0)

    /// SQL 累计耗时 ms
    sqlTotalMs Int @default(0)

    /// 单条 SQL 最大耗时 ms
    sqlMaxMs Int @default(0)

    /// 请求时间窗内事件循环最大卡顿 ms（≈SQL 最大耗时=硬阻塞；≈0 但总耗时长=事件等待）
    loopLagMaxMs Int @default(0)

    /// 结构化阶段时间线（排队/鉴权/RPC/SQL 明细等，JSON 数组）
    timeline Json?

    created DateTime @default(now())

    @@index([created])
    @@index([totalMs])
}

