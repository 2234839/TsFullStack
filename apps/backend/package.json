{
  "name": "@tsfullstack/backend",
  "files": [
    "dist-lib",
    "./src/lib/index.ts",
    "config.schema.json",
    "config.example.json",
    "CONFIG.md"
  ],
  "type": "module",
  "main": "./dist-lib/index.mjs",
  "types": "./dist-lib/index.d.mts",
  "scripts": {
    "prebuild": "zenstack generate",
    "predev": "zenstack generate",
    "zenstack:generate": "zenstack generate",
    "build": "vp pack",
    "build:publish": "pnpm build && pnpm --filter website-frontend build && pnpm publish:server",
    "publish:server": "bash ./publish.sh",
    "tsc:b": "tsc -b",
    "dev": "node dev.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:w": "node --enable-source-maps --watch ./dist/index.mjs",
    "build:w": "vp pack --watch",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:api": "tsx test/run-tests.ts",
    "test:manual": "tsx test/manual-test.ts",
    "build:projects": "tsx src/scripts/build-projects.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.1.3",
    "@tsfullstack/note-calc-engine": "workspace:*",
    "@zenstackhq/orm": "^3.8.3",
    "@zenstackhq/plugin-policy": "^3.8.3",
    "@zenstackhq/schema": "^3.8.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "crypto-js": "^4.2.0",
    "effect": "^3.22.0",
    "fastify": "^5.10.0",
    "superjson": "^2.2.6",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "catalog:",
    "@zenstackhq/cli": "^3.8.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "jsonSchema": {
    "config": "./config.schema.json"
  }
}
