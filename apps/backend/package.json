{
  "name": "@tsfullstack/backend",
  "files": [
    "dist-lib",
    "./src/lib/index.ts",
    "config.schema.json",
    "config.example.json",
    "CONFIG.md"
  ],
  "type": "module",
  "main": "./dist-lib/index.mjs",
  "types": "./dist-lib/index.d.mts",
  "scripts": {
    "prebuild": "zenstack generate",
    "predev": "zenstack generate",
    "zenstack:generate": "zenstack generate",
    "build": "node scripts/write-version.mjs && vp pack",
    "build:publish": "pnpm build && pnpm --filter website-frontend build && pnpm publish:server",
    "publish:server": "bash ./publish.sh",
    "tsc:b": "tsc -b",
    "check:effect": "tsx scripts/check-floating-effect.ts",
    "dev": "node dev.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:w": "node --enable-source-maps --watch ./dist/index.mjs",
    "build:w": "vp pack --watch",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:api": "tsx test/run-tests.ts",
    "test:manual": "tsx test/manual-test.ts",
    "build:projects": "tsx src/scripts/build-projects.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@tsfullstack/note-calc-engine": "workspace:*",
    "@zenstackhq/orm": "3.10.1",
    "@zenstackhq/plugin-policy": "3.10.1",
    "@zenstackhq/plugin-soft-delete": "3.10.1",
    "@zenstackhq/schema": "3.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "effect": "^4.1.2",
    "fastify": "^5.12.8",
    "superjson": "^2.2.6",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zenstackhq/cli": "3.10.1",
    "@zenstackhq/language": "3.10.1",
    "@zenstackhq/sdk": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "jsonSchema": {
    "config": "./config.schema.json"
  }
}
