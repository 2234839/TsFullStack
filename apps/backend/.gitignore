node_modules
.zenstack_repl_history
/dist
/dist-*
/uploads

# ZenStack v3 生成的文件
/.zenstack

# 排除私有前缀的子项目目录（以 _ 开头的目录）
/projects/_*/

/config.ts
.tsup/

/prisma/*
!/prisma/migrations
/prisma/migrations/development
~schema.prisma

# 默认的数据库文件路径（如果不在 .gitignore 中，则可能会误提交数据库文件）
/database

# 部署脚本生成的临时文件（发布时远端专用 package.json）
package.remote.json

# 本地生成的 prisma schema 与迁移快照（部署产物）
prisma-deploy/
